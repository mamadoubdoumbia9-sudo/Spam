<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhAlert" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors. -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        
        <!-- Secondary brand colors. -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>
        
        <!-- Tertiary brand colors. -->
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>
        <item name="colorOnTertiary">@color/color_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/color_on_tertiary_container</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/color_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        
        <!-- Background colors -->
        <item name="colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.WhAlert.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.WhAlert.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.WhAlert.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.WhAlert.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.WhAlert.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.WhAlert.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.WhAlert.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.WhAlert.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.WhAlert.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.WhAlert.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.WhAlert.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.WhAlert.LabelSmall</item>
        
        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.WhAlert.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WhAlert.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.WhAlert.LargeComponent</item>
        
        <!-- Elevation -->
        <item name="elevationLevel1">4dp</item>
        <item name="elevationLevel2">8dp</item>
        <item name="elevationLevel3">12dp</item>
        <item name="elevationLevel4">16dp</item>
        <item name="elevationLevel5">24dp</item>
    </style>
    
    <style name="Theme.WhAlert.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    
    <!-- Typography -->
    <style name="TextAppearance.WhAlert.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>
    
    <style name="TextAppearance.WhAlert.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>
    
    <style name="TextAppearance.WhAlert.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>
    
    <!-- Shapes -->
    <style name="ShapeAppearance.WhAlert.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    
    <style name="ShapeAppearance.WhAlert.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    
    <style name="ShapeAppearance.WhAlert.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
